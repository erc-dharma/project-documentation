<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://raw.githubusercontent.com/erc-dharma/project-documentation/master/schema/latest/DHARMA_Schema.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<?xml-model href="https://raw.githubusercontent.com/erc-dharma/project-documentation/master/schema/latest/DHARMA_Schema.rng" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="https://raw.githubusercontent.com/erc-dharma/project-documentation/master/schema/latest/DHARMA_SQF.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="https://epidoc.stoa.org/schema/latest/tei-epidoc.rng" schematypens="http://relaxng.org/ns/structure/1.0"?>
<?xml-model href="https://epidoc.stoa.org/schema/latest/tei-epidoc.rng" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:lang="eng">
   <teiHeader>
      <fileDesc>
         <titleStmt>
            <title>Encoding template for inscriptions</title>
            <!--Change the title of the file, e.g. Raktamālā grant of the time of Budhagupta, year 159-->
            <!--<title type="alt">Uncomment to add alternative titles</title>-->
            <respStmt>
               <resp key="creator"/>
               <!-- Insert the ID and name of the creator(s) of the digital edition. If applicable, use only <name> instead of <foreame> and <surname>. Iterate the <persName> element to add more than one creator. -->
               <persName ref="part:jodo">
                  <forename>John</forename>
                  <surname>Doe</surname>
               </persName>
            </respStmt>
            <!--To encode one or more contributors, duplicate the entire <respStmt> element above, change the @key on <resp> to "contributor", and edit the ID and name as applicable.-->
         </titleStmt>
         <publicationStmt>
            <authority><ref target="https://dharmalekha.info">DHARMA</ref></authority>
            <pubPlace><!-- Fill in here the place or places where the encoding has been done --></pubPlace>
            <idno type="filename">DHARMA_encodingTemplateInscription.xml</idno>
            <!-- Replace by the filename of your edition, e.g. DHARMA_INSPallava00001.xml-->
            <availability>
               <licence target="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA
                  4.0</licence>
            </availability>
            <date from="2019" to="2026">2019-2026</date>
         </publicationStmt>
         <sourceDesc>
            <!--Edit only the handDesc-->
            <msDesc>
               <msIdentifier>
                  <repository>as per external metadata</repository>
               </msIdentifier>
               <msContents>
                  <summary><!--Optionally add a summary of the inscription's content here--></summary>
               </msContents>
               <physDesc>
                  <handDesc>
                     <p><!--Enter your palaeographic description here. Feel free to use multiple paragraphs.--></p>
                     <!--To identify scribal hands, wrap <summary> around the <p> or <p>s above, and uncomment the following code, editing the xml:id and the contents as applicable and adding more handNote elements if necessary.-->
                     <!--<handNote xml:id="Pallava00001_hand1">description of first hand</handNote>
      						<handNote xml:id="Pallava00001_hand2">description of second hand</handNote>-->
                  </handDesc>
               </physDesc>
            </msDesc>
         </sourceDesc>
      </fileDesc>
      <encodingDesc>
         <!--Do not edit-->
         <p>Encoded in TEI/EpiDoc according to the <ref target="https://hal.science/halshs-02888186"
               >DHARMA Encoding Guide for Documentary Editions, version 2</ref></p>
      </encodingDesc>
      <revisionDesc>
         <!--When creating the edition, DELETE the change log of the template. Keep only one <change> item, populating it with your ID under @who and the appropriate date (when you start working on the file) and content (e.g. "Initial encoding"). For major subsequent alterations, add another <change> element ABOVE the last. -->
         <change who="part:daba" when="2026-09-07">Final revision to correspond to EGD
            release</change>
         <change who="part:mime" when="2026-07-21">Version 5 beta</change>
         <change who="part:axja" when="2021-06-02">Version 4</change>
         <change who="part:axja" when="2020-07-02">Version 3</change>
         <change who="part:axja" when="2020-03-18">Version 2</change>
         <change who="part:axja" when="2019-12-18" status="draft">Version 1</change>
      </revisionDesc>
   </teiHeader>
   <!-- Part to be used only, if you want to declare and link some photos with your encoding -->
   <facsimile>
      <graphic url="filename.jpg" xml:id="photo1"/>
      <!-- graphic should take at least an attribute @url containing either the https where the photo is stored or the filename of the file itself. An @xml:id can be declared if you want to link part of your encoding with a facsimile using the attribute @facs. -->
      <!-- If you want to provide a description, use the following pattern
      <graphic url="filename.jpg" xml:id="photo1">
      <desc>Some description</desc>
      </graphic>-->
   </facsimile>
   <text xml:space="preserve">
      <body>
         <div type="edition" xml:lang="san-Latn" rendition="class:00000 maturity:00000"><!-- update the values of @xml:lang and @rendition according to the language and source script of your text-->
            <!--edition goes here-->
            <lb n="1"/>
         </div>
         <div type="apparatus">
           <!--populate the skeleton apparatus as applicable, iterating <app> elements for each entry-->
               <listApp>
                  <app loc="0">
                     <lem/>
                     <rdg source="bib:AuthorYear_01"/>
                     <note/>
                  </app>
               </listApp>
         </div>
         <div type="translation">
 	         <!--translation goes here -->
         </div>
         <div type="commentary">
            <!--commentary goes here -->
         </div>
        <div type="bibliography">
	        <!--bibliography goes here -->
           <p><!--epigraphic lemma --></p>
        	<listBibl type="primary">
				<bibl n="siglum"/>
			</listBibl>
        <listBibl type="secondary">
           <bibl/>
        </listBibl>
        </div>
      </body>
  </text>
</TEI>
